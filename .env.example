# ==============================================================================
# ZEROX NETWORK - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# NOTE: Never commit production credentials, secret keys, or passwords.
# Populate these values in your Railway Dashboard (Variables) and local .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME CONFIGURATION (Server-side)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
APP_URL=https://your-domain.railway.app
ADMIN_KEY=your-secure-admin-secret-key

# ------------------------------------------------------------------------------
# 2. FIREBASE FRONTEND CONFIGURATION (Client-side / Vite prefixed)
# Obtain these from your NEW Firebase Console -> Project Settings -> General -> Web App
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-new-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-new-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-new-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
VITE_FIREBASE_DATABASE_ID=(default)

# ------------------------------------------------------------------------------
# 3. FIREBASE ADMIN SDK SERVICE ACCOUNT (Server-side)
# Obtain from NEW Firebase Console -> Project Settings -> Service Accounts -> Generate Private Key
# For Railway, you can provide FIREBASE_SERVICE_ACCOUNT_JSON as a single minified JSON string,
# or specify the individual credentials below:
# ------------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=your-new-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-new-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI CONFIGURATION (Server-side)
# Obtain from Google AI Studio (https://aistudio.google.com)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-google-gemini-api-key

# ------------------------------------------------------------------------------
# 5. NOWPAYMENTS CRYPTO PAYMENT GATEWAY (Server-side)
# Obtain from NOWPayments Dashboard (https://account.nowpayments.io)
# ------------------------------------------------------------------------------
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-nowpayments-ipn-secret-key
NOWPAYMENTS_SANDBOX=false

# ------------------------------------------------------------------------------
# 6. SMTP EMAIL SERVICE CONFIGURATION (Server-side / Nodemailer)
# Used for order alerts, OTP verification, password resets, and user notifications.
# If using Gmail, generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=zeroxnetworks@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_ALERTS_FROM_EMAIL=zeroxnetworks@gmail.com
ADMIN_ALERT_EMAIL=zeroxnetworks@gmail.com

# ------------------------------------------------------------------------------
# 7. IMAP EMAIL DEPOSIT LISTENER (Server-side / ImapFlow)
# Used by paymentEngine to parse bank deposit / payment confirmation emails automatically.
# ------------------------------------------------------------------------------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-payment-alerts@gmail.com
IMAP_PASS=your-gmail-app-password

# ------------------------------------------------------------------------------
# 8. SMM & SMS PROVIDER API KEYS (Server-side / Optional env overrides)
# Can be configured via environment variables or directly inside the Admin Panel DB.
# ------------------------------------------------------------------------------
PROVIDER_API_KEY=
FIVESIM_API_KEY=
SIM5_API_KEY=
SMS_ACTIVATE_API_KEY=
DAISYSMS_API_KEY=
SMM_PROVIDER_API_KEY=
