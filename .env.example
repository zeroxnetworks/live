# ==============================================================================
# ZEROX NETWORK - PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Never commit production credentials. Keep server secrets in the hosting
# provider's encrypted environment-variable store.
#
# Recommended production topology:
# - Vercel: frontend/static web app
# - Persistent Node host: Express API + workers (WhatsApp/IMAP/polling/backups)
# - Firebase: Auth + Firestore + Storage
#
# Firebase Vite variables are public client configuration. Everything else in
# this file is server-side unless explicitly documented otherwise.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION / SERVER
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
APP_URL=https://zeroxnetwork.com
ADMIN_KEY=

# ------------------------------------------------------------------------------
# 2. FIREBASE WEB APP (PUBLIC VITE CONFIG)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_DATABASE_ID=(default)

# ------------------------------------------------------------------------------
# 3. FIREBASE ADMIN SDK (SERVER ONLY)
# Prefer a secret-manager/environment variable. Never expose these to Vite.
# ------------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# 4. GEMINI AI (SERVER ONLY)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 5. NOWPAYMENTS (SERVER ONLY)
# ------------------------------------------------------------------------------
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false

# ------------------------------------------------------------------------------
# 6. SMTP EMAIL (SERVER ONLY)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_ALERTS_FROM_EMAIL=
ADMIN_ALERT_EMAIL=

# ------------------------------------------------------------------------------
# 7. IMAP PAYMENT LISTENER (SERVER / PERSISTENT WORKER ONLY)
# ------------------------------------------------------------------------------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# ------------------------------------------------------------------------------
# 8. PROVIDER OVERRIDES (SERVER ONLY)
# Prefer the authenticated admin settings API/Firestore for managed providers.
# Never send provider credentials to the browser.
# ------------------------------------------------------------------------------
PROVIDER_API_KEY=
FIVESIM_API_KEY=
SIM5_API_KEY=
SMS_ACTIVATE_API_KEY=
DAISYSMS_API_KEY=
SMM_PROVIDER_API_KEY=

# ------------------------------------------------------------------------------
# 9. WORKER / DURABLE STORAGE
# Configure these when the persistent worker is enabled.
# ------------------------------------------------------------------------------
BACKUP_STORAGE_BUCKET=
BACKUP_PREFIX=zerox-backups
WORKER_ENABLED=true
